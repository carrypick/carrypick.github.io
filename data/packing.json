    "notes": [
      {
        "maker": [
          {
            "by": [
              "flight"
            ]
          }
        ],
        "text": "<strong>Power banks go in your cabin bag only</strong>, never in check-in. Keep them with you, not in the overhead bin, and don't use them on board. Many airlines allow up to 2, each 100 Wh or less. Not sure about yours? Use the <a href=\"../tools/power-bank-flight-check.html\">power bank flight checker</a>."
      },
      {
        "maker": [
          {
            "by": [
              "flight"
            ]
          }
        ],
        "text": "<strong>Liquids in the cabin bag:</strong> each bottle 100 ml or less, all in one clear 1-litre zip bag. This applies on domestic flights too. Pack bigger bottles in check-in."
      },
      {
        "maker": [
          {
            "by": [
              "flight"
            ]
          }
        ],
        "text": "Not sure about an item? Search <a href=\"../baggage/can-i-carry.html\">what you can carry on a flight</a>, and check your bag with the <a href=\"../baggage/checker.html\">cabin bag checker</a>."
      },
      {
        "maker": [
          {
            "by": [
              "flight"
            ],
            "who": [
              "baby"
            ]
          }
        ],
        "text": "<strong>Baby food and milk</strong> for the journey are allowed in the cabin above 100 ml. Security may ask to check them."
      },
      {
        "maker": [
          {
            "by": [
              "train"
            ]
          }
        ],
        "text": "<strong>On the train:</strong> keep valuables in a small bag on you and lock the big bag to the berth. See how much the <a href=\"../baggage/train-luggage-rules.html\">train luggage rules</a> allow."
      },
      {
        "maker": [
          {
            "where": [
              "abroad"
            ]
          }
        ],
        "text": "<strong>Passport:</strong> most countries want it valid for at least 6 months after you arrive. Check the visa rules for your country, and <a href=\"../baggage/customs.html\">what you can bring back to India duty free</a>."
      },
      {
        "maker": [
          {
            "type": [
              "pilgrimage"
            ]
          }
        ],
        "text": "<strong>At the temple:</strong> many temples don't allow phones, leather or bags inside. Most have a cloak room or lockers near the gate, so carry little."
      },
      {
        "maker": [
          {
            "type": [
              "hills"
            ],
            "season": [
              "winter"
            ]
          }
        ],
        "text": "<strong>Snow:</strong> roads can close after heavy snow. Keep one extra day free, and wear layers you can take off in the car."
      }
    ],
