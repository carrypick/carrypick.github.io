      "label": "Weekend trip",
      "days": 2,
      "title": "Weekend trip packing list",
      "intro": "Two or three days away? Pack light. One cabin trolley or a 30–40 litre backpack is enough, and you skip the queue at the baggage belt."
    },
    {
      "slug": "week",
      "label": "Week-long holiday",
      "days": 6,
      "title": "Packing list for a week-long holiday",
      "intro": "A week away usually fits in a medium check-in trolley, or in a cabin trolley if you pack smart and plan to wash clothes once."
    },
    {
      "slug": "business",
      "label": "Work trip",
      "days": 3,
      "title": "Business trip packing list",
      "intro": "Keep work trips simple: one cabin bag, outfits that mix and match, and your laptop and chargers within reach."
    },
    {
      "slug": "wedding",
      "label": "Wedding",
      "days": 3,
      "title": "Wedding packing list: what to carry to a family wedding",
      "intro": "Weddings mean many functions and many outfits. Count one outfit per function, pack the heavy ones flat, and keep jewellery and the gift in your cabin bag."
    },
    {
      "slug": "hills",
      "label": "Winter hill trip",
      "days": 5,
      "title": "Hill station packing list for winter: Manali, Shimla, Kashmir",
      "intro": "Hill stations get very cold from November to February. Pack in layers, carry thermals, and protect your skin from the dry air and strong sun."
    },
    {
      "slug": "beach",
      "label": "Beach trip",
      "days": 4,
      "title": "Beach trip packing list for Goa and more",
      "intro": "Beach trips need light cotton clothes, sun protection and somewhere to keep wet things. Leave room in the bag for what you buy there."
    },
    {
      "slug": "train",
      "label": "Long train journey",
      "days": 2,
      "title": "Train journey packing list for Indian Railways",
      "intro": "Long train journeys are easier with food, water, a way to lock your bag and something warm for the AC coach. Keep valuables in a small bag on you."
    },
    {
      "slug": "abroad",
      "label": "Trip abroad",
      "days": 7,
      "title": "International trip packing list for Indians",
      "intro": "Going abroad? Documents come first: passport, visa, insurance and some local currency. Then check your airline's baggage allowance before you pack."
    }
